<?xml version="1.0" encoding="utf-8"?>
<!-- Empty-state action row (web search, Gemini): surface card with hairline stroke, ripple clipped to the rounded shape.
     Focus ring is the view foreground (focus_ring_loom). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/loom_surface_hi">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@color/loom_surface" />
            <corners android:radius="@dimen/radius_chip" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/loom_surface" />
            <stroke android:width="@dimen/stroke_hairline" android:color="@color/loom_stroke" />
            <corners android:radius="@dimen/radius_chip" />
        </shape>
    </item>
</ripple>
