<?xml version="1.0" encoding="utf-8"?>
<!-- Focus ring (D-pad / keypad), used as view foreground: 2dp loom_accent, drawn inside the bounds. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <stroke android:width="@dimen/focus_ring" android:color="@color/loom_accent" />
            <corners android:radius="@dimen/radius_tile" />
        </shape>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
