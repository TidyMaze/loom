<?xml version="1.0" encoding="utf-8"?>
<!-- Item bottom sheet: bottom-gravity, slides up (MainActivity.showItemSheet). Body scrolls above 70% of screen height. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sheet_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/sheet_glass_bg"
    android:paddingBottom="@dimen/space_8">

    <View
        android:id="@+id/sheet_handle"
        android:layout_width="32dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/space_8"
        android:background="@drawable/sheet_handle"
        android:importantForAccessibility="no" />

    <!-- Header: icon 40dp, title 20sp medium, caption with last-opened and launch count. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingTop="@dimen/space_16"
        android:paddingBottom="@dimen/space_16">

        <ImageView
            android:id="@+id/sheet_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/space_16">

            <TextView
                android:id="@+id/sheet_title"
                style="@style/Loom.Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true" />

            <TextView
                android:id="@+id/sheet_caption"
                style="@style/Loom.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </LinearLayout>

    </LinearLayout>

    <!-- Visible cue that the body scrolls: a fading edge at the overflowing side and an always-shown scrollbar. -->
    <ScrollView
        android:id="@+id/sheet_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="vertical"
        android:fadeScrollbars="false"
        android:requiresFadingEdge="vertical"
        android:fadingEdgeLength="@dimen/space_24">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/space_8">

            <!-- Shortcuts rows are added in code (48dp, icon 24dp). -->
            <LinearLayout
                android:id="@+id/layout_shortcuts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />

            <View
                android:id="@+id/sheet_divider"
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke_hairline"
                android:layout_marginStart="@dimen/screen_margin"
                android:layout_marginEnd="@dimen/screen_margin"
                android:layout_marginTop="@dimen/space_8"
                android:layout_marginBottom="@dimen/space_8"
                android:background="@color/loom_stroke"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/sheet_hide"
                style="@style/Loom.Text.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_min"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/screen_margin"
                android:paddingEnd="@dimen/screen_margin"
                android:drawablePadding="@dimen/space_16"
                android:drawableStart="@drawable/ic_sheet_hide"
                android:drawableTint="@color/loom_text"
                android:text="@string/sheet_hide_app"
                android:background="?attr/selectableItemBackground"
                android:foreground="@drawable/focus_ring_loom"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/sheet_info"
                style="@style/Loom.Text.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_min"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/screen_margin"
                android:paddingEnd="@dimen/screen_margin"
                android:drawablePadding="@dimen/space_16"
                android:drawableStart="@drawable/ic_sheet_info"
                android:drawableTint="@color/loom_text"
                android:text="@string/sheet_app_info"
                android:background="?attr/selectableItemBackground"
                android:foreground="@drawable/focus_ring_loom"
                android:clickable="true"
                android:focusable="true" />

            <!-- Destructive action last. -->
            <TextView
                android:id="@+id/sheet_reset"
                style="@style/Loom.Text.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_min"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/screen_margin"
                android:paddingEnd="@dimen/screen_margin"
                android:drawablePadding="@dimen/space_16"
                android:drawableStart="@drawable/ic_sheet_reset"
                android:drawableTint="@color/loom_danger"
                android:text="@string/sheet_reset_stats"
                android:textColor="@color/loom_danger"
                android:background="?attr/selectableItemBackground"
                android:foreground="@drawable/focus_ring_loom"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
