<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settings_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/loom_bg"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/settings_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingTop="@dimen/space_8"
        android:paddingBottom="@dimen/space_32">

        <!-- Header: back (48dp target) + display title. Status inset is added in SettingsActivity. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="@dimen/touch_min"
                android:layout_height="@dimen/touch_min"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_back"
                android:padding="@dimen/space_12"
                android:src="@drawable/ic_arrow_back" />

            <TextView
                android:id="@+id/settings_title"
                style="@style/Loom.Text.Display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_8"
                android:accessibilityHeading="true"
                android:text="@string/settings_title"
                android:textSize="28sp" />

        </LinearLayout>

        <TextView
            style="@style/Loom.Text.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/space_24"
            android:paddingBottom="@dimen/space_8"
            android:paddingStart="@dimen/space_4"
            android:text="@string/section_layout" />

        <LinearLayout
            android:id="@+id/card_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:orientation="vertical" />

        <TextView
            style="@style/Loom.Text.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/space_24"
            android:paddingBottom="@dimen/space_8"
            android:paddingStart="@dimen/space_4"
            android:text="@string/section_detox" />

        <!-- Rows added in SettingsActivity: web search switch, hide-apps link, divider, hidden apps list. -->
        <LinearLayout
            android:id="@+id/card_detox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:orientation="vertical" />

        <TextView
            style="@style/Loom.Text.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/space_24"
            android:paddingBottom="@dimen/space_8"
            android:paddingStart="@dimen/space_4"
            android:text="@string/section_tracking" />

        <LinearLayout
            android:id="@+id/card_tracking"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:orientation="vertical" />

        <TextView
            style="@style/Loom.Text.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/space_24"
            android:paddingBottom="@dimen/space_8"
            android:paddingStart="@dimen/space_4"
            android:text="@string/section_data" />

        <LinearLayout
            android:id="@+id/card_data"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>
