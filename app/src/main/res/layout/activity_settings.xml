<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textSize="28sp"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif-light"
            android:paddingBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hidden"
            android:textSize="13sp"
            android:textColor="#888888"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.1"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:id="@+id/section_hidden"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tracking"
            android:textSize="13sp"
            android:textColor="#888888"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.1"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/btn_usage_access"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:gravity="center_vertical"
            android:text="Usage access"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/usage_access_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#888888"
            android:paddingBottom="20dp" />

        <TextView
            android:id="@+id/btn_notif_access"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:gravity="center_vertical"
            android:text="Notification access"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/notif_access_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#888888"
            android:paddingBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Data"
            android:textSize="13sp"
            android:textColor="#888888"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.1"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/btn_clear_usage"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:text="Clear usage data"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/btn_reset_all"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:text="Reset everything"
            android:textSize="16sp"
            android:textColor="#E57373"
            android:background="?attr/selectableItemBackground" />

    </LinearLayout>
</ScrollView>
