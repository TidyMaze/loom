<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/loom_bg">

    <LinearLayout
        android:id="@+id/layout_main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Greeting row: heading + settings target (48dp) at top-end. Top padding = status inset + 16dp (set in MainActivity). -->
        <LinearLayout
            android:id="@+id/layout_greeting_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingEnd="@dimen/space_8"
            android:paddingTop="@dimen/space_16"
            android:paddingBottom="@dimen/space_4">

            <TextView
                android:id="@+id/tv_greeting"
                style="@style/Loom.Text.Display"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:letterSpacing="0.01" />

            <ImageButton
                android:id="@+id/btn_settings"
                android:layout_width="@dimen/touch_min"
                android:layout_height="@dimen/touch_min"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:foreground="@drawable/focus_ring_loom"
                android:contentDescription="@string/settings_title"
                android:scaleType="center"
                android:src="@drawable/ic_gear" />

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="2dp"
            android:paddingBottom="@dimen/space_16"
            android:scrollbarStyle="outsideOverlay"
            android:scrollbars="none" />

        <!-- Web fallback: full-width 48dp text rows, shown only when no app matches. -->
        <LinearLayout
            android:id="@+id/layout_empty_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/space_8"
            android:visibility="gone">

            <!-- Action rows: leading icon, trailing chevron, surface with ripple. Role "button" is set in MainActivity. -->
            <TextView
                android:id="@+id/btn_open_chrome"
                style="@style/Loom.Text.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_8"
                android:minHeight="@dimen/touch_min"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/space_16"
                android:paddingTop="@dimen/space_12"
                android:paddingEnd="@dimen/space_16"
                android:paddingBottom="@dimen/space_12"
                android:drawablePadding="@dimen/space_12"
                android:drawableStart="@drawable/ic_search"
                android:drawableEnd="@drawable/ic_chevron_right"
                android:drawableTint="@color/loom_text_2"
                android:background="@drawable/empty_action_bg"
                android:foreground="@drawable/focus_ring_loom"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btn_open_gemini"
                style="@style/Loom.Text.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_min"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/space_16"
                android:paddingTop="@dimen/space_12"
                android:paddingEnd="@dimen/space_16"
                android:paddingBottom="@dimen/space_12"
                android:drawablePadding="@dimen/space_12"
                android:drawableStart="@drawable/ic_sparkle"
                android:drawableEnd="@drawable/ic_chevron_right"
                android:drawableTint="@color/loom_text_2"
                android:text="@string/search_gemini"
                android:background="@drawable/empty_action_bg"
                android:foreground="@drawable/focus_ring_loom"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <!-- Bottom search dock (thumb zone). Bottom padding = nav bar or IME inset + 12dp (MainActivity). -->
        <LinearLayout
            android:id="@+id/layout_dock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingTop="@dimen/space_8"
            android:paddingBottom="@dimen/space_12">

            <LinearLayout
                android:id="@+id/search_pill"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/search_bg"
                android:paddingStart="@dimen/space_16"
                android:paddingEnd="@dimen/space_4">

                <ImageView
                    android:id="@+id/iv_search_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_search" />

                <EditText
                    android:id="@+id/et_search"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_12"
                    android:paddingTop="@dimen/space_12"
                    android:paddingBottom="@dimen/space_12"
                    android:background="@null"
                    android:hint="@string/search_hint"
                    android:textColorHint="@color/loom_text_2"
                    android:textColor="@color/loom_text"
                    android:textSize="16sp"
                    android:inputType="text"
                    android:imeOptions="actionSearch"
                    android:maxLines="1" />

                <ImageButton
                    android:id="@+id/btn_clear_search"
                    android:layout_width="@dimen/touch_min"
                    android:layout_height="@dimen/touch_min"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:foreground="@drawable/focus_ring_loom"
                    android:contentDescription="@string/search_clear"
                    android:scaleType="center"
                    android:src="@drawable/ic_clear"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <include layout="@layout/view_onboarding" />

</FrameLayout>
