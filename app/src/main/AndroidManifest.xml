<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- System-wide app launch tracking; special permission, must be granted via
         Settings → Apps → Special access → Usage access. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- WiFi SSID hash used as a coarse location proxy (home/work/transit).
         FINE_LOCATION is required on Android 8.0+ to read SSID. SSID is hashed
         locally (SHA-256 truncated) before storage; raw network names never leave the device. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Calendar event proximity feature: read next 30 min of events to predict app affinity. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!-- Activity recognition: detect walking / in-vehicle / still to predict app affinity. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <!-- Bluetooth device name hash (specific device beyond audioDevice category). -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Haptic feedback vibration permission -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Loom"
        android:theme="@style/Theme.AppCompat.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="Settings" />

        <!-- Listens for active notifications system-wide. Provides per-package
             notification counts used as a live ranking feature. User must grant
             "Notification access" in Settings (no runtime perm available). -->
        <service
            android:name=".LoomNotificationListener"
            android:label="Loom Notification Access"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Receives ActivityRecognition broadcasts to update ActivityState singleton. -->
        <receiver
            android:name=".ActivityRecognitionReceiver"
            android:exported="false" />

    </application>

</manifest>
